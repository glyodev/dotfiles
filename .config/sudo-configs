# /etc/systemd/system/wakeup-config.service
[Unit]
Description=Configurar wakeup de dispositivos
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo enabled > /sys/devices/platform/i8042/serio0/power/wakeup'
ExecStart=/bin/sh -c 'echo disabled > /sys/devices/platform/AMDI0010:03/i2c-1/i2c-SYNA32D8:00/power/wakeup'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

# /etc/udev/rules.d/99-usb-sounds.rules
ACTION=="add", SUBSYSTEM=="usb", RUN+="/usr/bin/su gary -c 'XDG_RUNTIME_DIR=/run/user/1000 play /usr/share/sounds/freedesktop/stereo/device-added.oga'"
ACTION=="remove", SUBSYSTEM=="usb", RUN+="/usr/bin/su gary -c 'XDG_RUNTIME_DIR=/run/user/1000 play /usr/share/sounds/freedesktop/stereo/device-removed.oga'"

# /etc/containerd/config.toml
version = 2
root = "/glyo/Linux/.containerd"
