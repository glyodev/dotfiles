#!/bin/bash

# Colors
GREEN="\e[1;32m"
CYAN="\e[1;36m"
RED="\e[1;31m"
YELLOW="\e[1;33m"
GRAY="\e[0;37m"
BOLD="\e[1m"
RESET="\e[0m"

print_header() {
    clear
    
    echo -e "${CYAN}┌──────────────────────────────────────────────────────────────────┐${RESET}"
    echo -e "${CYAN}│                    🚀 ${BOLD}Developer Launcher 🚀${RESET}${CYAN}                      │${RESET}"
    echo -e "${CYAN}└──────────────────────────────────────────────────────────────────┘${RESET}"
    
    echo -e "${CYAN}╭──────────────────────────────────────────────────────────────────╮${RESET}"
    echo -e "${CYAN}│${RESET}  ${GRAY}Quick project launcher for your development workflow.${RESET}           ${CYAN}│${RESET}"
    echo -e "${CYAN}│${RESET}                                                                  ${CYAN}│${RESET}"
    echo -e "${CYAN}│${RESET}  ${GREEN}•${RESET} Open projects with ${BOLD}OpenCode${RESET}, ${BOLD}VSCode${RESET}, or terminal.             ${CYAN}│${RESET}"
    echo -e "${CYAN}│${RESET}  ${GREEN}•${RESET} Automatically create missing directories.                     ${CYAN}│${RESET}"
    echo -e "${CYAN}│${RESET}  ${GREEN}•${RESET} Integrated with ${BOLD}i3wm${RESET} workspaces.                              ${CYAN}│${RESET}"
    echo -e "${CYAN}│${RESET}  ${GREEN}•${RESET} Multi-select launch options with ${BOLD}gum${RESET}.                         ${CYAN}│${RESET}"
    echo -e "${CYAN}╰──────────────────────────────────────────────────────────────────╯${RESET}"
    
    echo -e "\n ${YELLOW}Tips:${RESET}"
    echo -e " ${GRAY}• TAB${RESET} autocomplete directory"
    echo -e " ${GRAY}• SPACE${RESET} select options"
    echo -e " ${GRAY}• ENTER${RESET} confirm"
    echo -e " ${GRAY}• Ctrl+D${RESET} exit\n"
}

print_header

launch_apps() {
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────${RESET}"
    echo -e "\n ${CYAN}🚀 Opening:${RESET} ${BOLD}$(pwd)${RESET}\n"
    
    options=$(gum choose --no-limit \
        --cursor.foreground="#00ffff" \
        --selected.foreground="#00ff00" \
        --selected-prefix="✓ " \
        --cursor-prefix=" " \
        --selected="󰅨 OpenCode" \
        " Open terminal" \
        "󰨞 VSCode" \
        "󰅨 OpenCode"
    )
    
    if [[ -n "$options" ]]; then
        [[ "$options" == *"󰅨 OpenCode"* ]] && \
        setsid alacritty \
        --working-directory "$(pwd)" \
        -e opencode "$(pwd)" \
        >/dev/null 2>&1 &
        sleep 0.25
        
        [[ "$options" == *" Open terminal"* ]] && \
        setsid alacritty \
        --working-directory "$(pwd)" \
        >/dev/null 2>&1 &
        sleep 0.25
        
        [[ "$options" == *"󰨞 VSCode"* ]] && \
        i3-msg "workspace 2; exec code \"$(pwd)\""
        sleep 1
        exit
    else
        echo -e " ${RED}❌ No option selected${RESET}"
        sleep 0.5
    fi
}

while true; do
    echo -e "${CYAN}────────────────────────────────────────────────────────────────────${RESET}"
    echo -e " ${GRAY}📍 $(pwd)${RESET}"
    
    if ! read -e -p "$(echo -e " ${GREEN}📁 Directory:${RESET} ")" dir; then
        echo -e "\n ${CYAN}👋 Exiting...${RESET}\n"
        sleep 1
        exit
    fi
    
    if [ -z "$dir" ]; then
        echo -e " ${RED}❌ No directory entered${RESET}"
        continue
    fi
    
    # Resolve full path
    if [[ "$dir" = /* ]]; then
        full_path="$dir"
    else
        full_path="$(pwd)/$dir"
    fi
    
    if [ -d "$full_path" ]; then
        cd "$full_path" || continue
        launch_apps
    else
        echo
        
        if gum confirm --default=false "Directory does not exist. Create it?"; then
            mkdir -p "$full_path"
            cd "$full_path" || continue
            
            echo -e "\n ${CYAN}📁 Directory created:${RESET} ${BOLD}$full_path${RESET}\n"
            
            launch_apps
        else
            echo -e " ${RED}❌ Does not exist:${RESET} ${BOLD}$full_path${RESET}"
        fi
    fi
done
